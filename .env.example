# Frontend API base.
# Leave unset on Vercel so the frontend uses same-origin /api.
# For local dev, the code defaults to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# Soil Salinity Mapper generation.
# Vercel serves the checked-in generated map by default. Set this true only if
# you intentionally enable server-side map generation in the deployed backend.
ENABLE_SOIL_MAP_GENERATION=false

# Optional absolute path to the Python executable used for local map generation.
# Leave empty to use backend/.venv or the current Python interpreter.
SOIL_SALINITY_PYTHON=

# Optional Google Earth Engine project used only by local experimental checks.
EARTHENGINE_PROJECT=your-google-cloud-project-id
